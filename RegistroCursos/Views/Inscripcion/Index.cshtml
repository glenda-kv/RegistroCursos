@model IEnumerable<RegistroCursos.Models.Inscripcion>

@{
    ViewData["Title"] = "Inscripciones";
}


<style>

    body{
        background:#fff7fb;
    }


    .card-custom{

        background:white;
        border-radius:20px;
        padding:25px;
        box-shadow:0 8px 20px rgba(0,0,0,0.08);

    }


    .titulo{

        color:#8e5ea2;
        font-weight:bold;

    }


    .btn-nuevo{

        background:#a8e6cf;
        color:#355c4d;
        border:none;
        border-radius:20px;
        padding:10px 20px;

    }


    .table thead{

        background:#d7c7ff;
        color:#4b3f72;

    }


    .btn-editar{

        background:#ffd3b6;
        border:none;
        color:#7a4b21;

    }


    .btn-eliminar{

        background:#ffaaa5;
        border:none;
        color:#7d2525;

    }

</style>




<div class="container">

    <div class="card-custom">


        <div class="d-flex justify-content-between align-items-center mb-4">


            <h2 class="titulo">
                📚 Registro de estudiantes a cursos
            </h2>



            <a asp-action="Create"
               class="btn btn-nuevo">

                ➕ Nueva inscripción

            </a>


        </div>




        <table class="table table-hover align-middle">


            <thead>

                <tr>

                    <th>
                        Estudiante
                    </th>


                    <th>
                        Curso
                    </th>


                    <th>
                        Fecha inscripción
                    </th>


                    <th>
                        Estado
                    </th>


                    <th>
                        Nota final
                    </th>


                    <th>
                        Acciones
                    </th>


                </tr>

            </thead>



            <tbody>


                @foreach (var item in Model)
                {


                    <tr>


                        <td>

                            @item.Estudiante.Nombre
                            @item.Estudiante.Apellido

                        </td>


                        <td>

                            @item.Curso.Nombre

                        </td>


                        <td>

                            @item.FechaInscripcion.ToShortDateString()

                        </td>


                        <td>

                            <span class="badge bg-success">

                                @item.Estado

                            </span>

                        </td>


                        <td>

                            @item.NotaFinal

                        </td>



                        <td>


                            <a asp-action="Edit"
                               asp-route-id="@item.IdInscripcion"
                               class="btn btn-sm btn-editar">

                                ✏ Editar

                            </a>



                            <a asp-action="Delete"
                               asp-route-id="@item.IdInscripcion"
                               class="btn btn-sm btn-eliminar">

                                🗑 Eliminar

                            </a>


                        </td>


                    </tr>


                }


            </tbody>


        </table>



    </div>


</div>