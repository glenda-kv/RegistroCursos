@model RegistroCursos.Models.Inscripcion

<div class="container mt-4">

    <div class="card p-4 shadow">

        <h2 style="color:#8e5ea2">
            ✏ Editar inscripción
        </h2>

        <hr />

        <form asp-action="Edit">

            <div asp-validation-summary="All" class="text-danger"></div>

            <input type="hidden" asp-for="IdInscripcion" />
            <input type="hidden" asp-for="FechaInscripcion" />


            <div class="mb-3">
                <label class="form-label">Estudiante</label>

                <select asp-for="IdEstudiante"
                        asp-items="ViewBag.Estudiantes"
                        class="form-select">
                </select>
            </div>


            <div class="mb-3">
                <label class="form-label">Curso</label>

                <select asp-for="IdCurso"
                        asp-items="ViewBag.Cursos"
                        class="form-select">
                </select>
            </div>


            <div class="mb-3">
                <label class="form-label">Estado</label>

                <select asp-for="Estado" class="form-select">
                    <option value="Activo">Activo</option>
                    <option value="Finalizado">Finalizado</option>
                    <option value="Retirado">Retirado</option>
                </select>
            </div>


            <div class="mb-3">
                <label class="form-label">Nota final</label>

                <input asp-for="NotaFinal"
                       class="form-control" />
            </div>


            <div class="mt-4">
                <button type="submit" class="btn btn-warning">
                    💾 Actualizar
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>
            </div>

        </form>

    </div>

</div>